OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
# Optional. Snapshot usage omits estimated cost until both rates are configured.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

DAYTONA_API_KEY=
DAYTONA_TARGET=us
DAYTONA_AUTO_STOP_MINUTES=60
DAYTONA_AUTO_ARCHIVE_MINUTES=10080
DAYTONA_AUTO_DELETE_MINUTES=43200

LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langalpha-local
LANGSMITH_API_KEY=

OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium
OPENAI_WEB_SEARCH_MAX_CALLS=12
MAX_RESEARCHER_MODEL_CALLS=16
MAX_RESEARCHER_TOOL_CALLS=40
# SEC asks automated clients to identify an organization and contact email.
SEC_USER_AGENT=
FRED_API_KEY=
MASSIVE_API_KEY=
MASSIVE_SNAPSHOTS_ENABLED=false

LANGGRAPH_SERVER_URL=http://127.0.0.1:2024
# Required by the Vercel BFF when LANGGRAPH_SERVER_URL is a protected deployment.
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=main

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=langalpha-assets

APP_PROJECT_ID=langalpha
APP_VERSION=development
APP_ENVIRONMENT=development

# JSON accepted by langchain-mcp-adapters. MCP calls run in the host process.
MCP_CONNECTIONS={}
MCP_TOOL_NAME_PREFIX=true
MCP_PTC_ALLOWLIST=[]
MCP_TOOL_ALLOWLIST=[]
MCP_MAX_CALLS_PER_RUN=100

MAX_MODEL_CALLS=20
MAX_TOOL_CALLS=80
MAX_ASYNC_SUBAGENTS=3
MAX_RUN_SECONDS=600
MAX_UPLOAD_BYTES=26214400
