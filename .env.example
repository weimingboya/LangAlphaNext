OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
# Optional. Usage events omit estimated cost until both rates are configured.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
COST_WARNING_USD=1

DAYTONA_API_KEY=
DAYTONA_TARGET=us
DAYTONA_AUTO_STOP_MINUTES=60
DAYTONA_AUTO_ARCHIVE_MINUTES=10080
DAYTONA_AUTO_DELETE_MINUTES=-1

LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langalpha-local
LANGSMITH_API_KEY=

LANGGRAPH_SERVER_URL=http://127.0.0.1:2024
LANGGRAPH_ASSISTANT_ID=main
LANGALPHA_API_URL=http://127.0.0.1:8000
LANGALPHA_INTERNAL_TOKEN=
LANGALPHA_DATABASE_PATH=.data/langalpha.db
LANGALPHA_PROJECT_ID=langalpha-local
LANGALPHA_OWNER_ID=local-user

# Optional in local mode. When configured, durable Outbox events are published
# to REDIS_EVENT_CHANNEL_PREFIX:<product_thread_id>.
REDIS_URL=
REDIS_EVENT_CHANNEL_PREFIX=langalpha:events
OUTBOX_POLL_INTERVAL_SECONDS=0.5

# JSON accepted by langchain-mcp-adapters. MCP calls run in the host process.
MCP_CONNECTIONS={}
MCP_TOOL_NAME_PREFIX=true
MCP_PTC_ALLOWLIST=[]
MCP_TOOL_ALLOWLIST=[]
MCP_MAX_CALLS_PER_RUN=100

MAX_MODEL_CALLS=40
MAX_TOOL_CALLS=150
MAX_ASYNC_SUBAGENTS=3
MAX_RUN_SECONDS=1200
MAX_UPLOAD_BYTES=26214400
STREAM_RECONNECT_ATTEMPTS=8
STREAM_RECONNECT_MAX_DELAY_SECONDS=5
